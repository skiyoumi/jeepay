# 生产环境编排变量（供 docker-compose.prod.yml 使用）
#
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml pull
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# 该文件被 .gitignore 忽略，可安全填写真实密码（切勿提交）。

# 私有镜像仓库地址，必须写到【仓库名】为止：<registry>/<namespace>/<repo>，结尾不带 /
# 六个镜像共用这一个仓库，靠 IMAGE_TAG 后面的角色后缀区分（见 docker-compose.prod.yml）：
#   <REGISTRY>:<IMAGE_TAG>-payment     <REGISTRY>:<IMAGE_TAG>-manager     <REGISTRY>:<IMAGE_TAG>-merchant
#   <REGISTRY>:<IMAGE_TAG>-ui-payment  <REGISTRY>:<IMAGE_TAG>-ui-manager  <REGISTRY>:<IMAGE_TAG>-ui-merchant
REGISTRY=crpi-1a0zvjxwrmr36txn.cn-hongkong.personal.cr.aliyuncs.com/skiyoumi/jneelypay

# 版本标签前缀：实际推上去的 tag 会在后面拼角色后缀，如 3.2.9-ezfp-payment。
# 升级/回滚只需改这一处，六个镜像整体切版本。
IMAGE_TAG=3.2.9-ezfp

# MySQL root 密码
# 注意：改这里还不够，必须同步修改 conf/payment|manager|merchant/application.yml 中的
#      spring.datasource.password，否则三个服务连不上库。
MYSQL_ROOT_PASSWORD=rootroot

# 基础镜像（默认使用可访问的公共镜像，无需修改）
# 若服务器无法拉取 Docker Hub / 华为云 SWR，可先在本机 pull 后打标签推到自己的 ACR，
# 再把下面三项改成 ${REGISTRY} 下的地址。
# MYSQL_IMAGE=mysql:8.0.25
# REDIS_IMAGE=swr.cn-south-1.myhuaweicloud.com/jeepay/redis:6.2.14
# ROCKETMQ_IMAGE=swr.cn-south-1.myhuaweicloud.com/jeepay/rocketmq:5.3.1
